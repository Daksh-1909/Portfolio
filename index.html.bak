            <div class="cert-overlay">
              <i class="fas fa-file-pdf"></i>
            </div>
          </div>
          <div class="cert-content">
            <div class="cert-badge">
              <i class="fas fa-certificate"></i>
            </div>
            <h3>JavaScript Programming</h3>
            <p class="cert-issuer"><i class="fas fa-building"></i> freeCodeCamp</p>
            <p class="cert-description">Complete JavaScript programming course certification</p>
            <div class="cert-meta">
              <span class="cert-date"><i class="far fa-calendar"></i> 2025</span>
              <a href="assets/certificates/free_codecamp - JS conv 1.png" target="_blank" class="cert-download">
                <i class="fas fa-eye"></i> View Certificate
              </a>
            </div>
          </div>
        </div>

        <!-- Certificate 6: Edureka JavaScript -->
        <div class="cert-card" data-cert="edureka-js">
          <div class="cert-image-wrapper">
            <div class="cert-placeholder js-placeholder"
