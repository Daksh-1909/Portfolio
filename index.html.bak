            <div class="cert-overlay">
              <i class="fas fa-search-plus"></i>
            </div>
          </div>
          <div class="cert-content">
            <div class="cert-badge">
              <i class="fas fa-certificate"></i>
            </div>
            <h3>HTML Full Course</h3>
            <p class="cert-issuer"><i class="fas fa-building"></i> Simplilearn</p>
            <p class="cert-description">Build a Website Tutorial - Complete HTML course certification</p>
            <div class="cert-meta">
              <span class="cert-date"><i class="far fa-calendar"></i> 2025</span>
            </div>
          </div>
        </div>

        <!-- Certificate 4: NPTEL Networks -->
        <div class="cert-card" data-cert="nptel">
          <div class="cert-image-wrapper">
            <div class="cert-placeholder nptel-placeholder">
              <i class="fas fa-network-wired"></i>
              <p>NPTEL Elite</p>
            </div>
            <img src="assets/certificates/NPTEL CN certificate conv 1.png" alt="NPTEL Certificate" class="cert-image"
              style="display: none;" />
            <div class="cert-overlay">
              <i class="fas fa-medal"></i>
            </div>
          </div>
          <div class="cert-content">
            <div class="cert-badge elite">
              <i class="fas fa-star"></i>
            </div>
            <h3>Computer Networks & Internet Protocol</h3>
            <p class="cert-issuer"><i class="fas fa-building"></i> IIT Kharagpur - NPTEL</p>
            <p class="cert-description">Elite certification with 75% score - Top 2% performer</p>
            <div class="cert-meta">
              <span class="cert-date"><i class="far fa-calendar"></i> Jan-Apr 2025</span>
              <span class="cert-score"><i class="fas fa-chart-line"></i> 75% (Top 2%)</span>
            </div>
          </div>
        </div>

        <!-- Certificate 5: freeCodeCamp JavaScript -->
        <div class="cert-card" data-cert="freecodecamp-js">
          <div class="cert-image-wrapper">
            <div class="cert-placeholder js-placeholder">
              <i class="fab fa-js"></i>
              <p>freeCodeCamp</p>
            </div>
            <img src="assets/certificates/free_codecamp - JS conv 1.png" alt="freeCodeCamp Certificate"
