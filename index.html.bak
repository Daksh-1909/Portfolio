  </section>

  <!-- Certificate Modal -->
  <div id="certModal" class="cert-modal">
    <span class="cert-modal-close">&times;</span>
    <img class="cert-modal-content" id="certModalImg" />
    <div id="certModalCaption"></div>
  </div>

  <!-- Contact Section -->
  <section id="contact" class="section bg-alt">
    <div class="container animate-on-scroll">
      <h2 class="section-title">Get In Touch</h2>
      <div class="contact-wrapper">
        <div class="contact-info">
          <p>Feel free to reach out for collaborations or just to say hi!</p>
          <a href="mailto:dakshp860@gmail.com" class="contact-item">
            <i class="fas fa-envelope"></i> dakshp860@gmail.com
          </a>
          <div class="social-links-large">
            <a href="https://www.linkedin.com/in/daksh-patel-7a57b222a/" target="_blank"><i
                class="fab fa-linkedin"></i></a>
            <a href="https://github.com/Daksh-1909" target="_blank"><i class="fab fa-github"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Daksh Patel. All rights reserved.</p>
