              <i class="fab fa-js" style="color: #f7df1e;"></i>
              <p style="color: #94a3b8;">Edureka</p>
            </div>
            <img src="assets/certificates/edureka - JS conv 1.png" alt="Edureka Certificate" class="cert-image"
              style="display: none;" />
            <div class="cert-overlay">
              <i class="fas fa-file-pdf"></i>
            </div>
          </div>
          <div class="cert-content">
            <div class="cert-badge">
              <i class="fas fa-certificate"></i>
            </div>
            <h3>JavaScript Course</h3>
            <p class="cert-issuer"><i class="fas fa-building"></i> Edureka</p>
            <p class="cert-description">JavaScript programming fundamentals and advanced concepts</p>
            <div class="cert-meta">
              <span class="cert-date"><i class="far fa-calendar"></i> 2025</span>
              <a href="assets/certificates/edureka - JS conv 1.png" target="_blank" class="cert-download">
                <i class="fas fa-eye"></i> View Certificate
              </a>
            </div>
          </div>
        </div>

        <!-- Certificate 7: Open Source -->
        <div class="cert-card" data-cert="opensource">
          <div class="cert-image-wrapper">
            <div class="cert-placeholder opensource-placeholder">
              <i class="fas fa-code-branch"></i>
              <p>Open Source</p>
            </div>
            <img src="assets/certificates/open source conv 1.png" alt="Open Source Certificate" class="cert-image"
              style="display: none;" />
            <div class="cert-overlay">
              <i class="fas fa-search-plus"></i>
            </div>
          </div>
          <div class="cert-content">
            <div class="cert-badge">
              <i class="fas fa-certificate"></i>
            </div>
            <h3>What is Open Source?</h3>
            <p class="cert-issuer"><i class="fas fa-building"></i> IBM SkillsBuild</p>
            <p class="cert-description">Understanding open source software development and collaboration</p>
            <div class="cert-meta">
              <span class="cert-date"><i class="far fa-calendar"></i> 2025</span>
              <a href="assets/certificates/open source conv 1.png" target="_blank" class="cert-download">
                <i class="fas fa-eye"></i> View Certificate
              </a>
            </div>
          </div>
        </div>

        <!-- Certificate 8: AWS Value Added Course -->
        <div class="cert-card" data-cert="aws-value">
          <div class="cert-image-wrapper">
            <div class="cert-placeholder">
              <i class="fab fa-aws"></i>
              <p>Parul University</p>
            </div>
            <div class="cert-overlay">
              <i class="fas fa-file-pdf"></i>
            </div>
          </div>
          <div class="cert-content">
            <div class="cert-badge">
              <i class="fas fa-award"></i>
            </div>
            <h3>AWS Value Added Course</h3>
            <p class="cert-issuer"><i class="fas fa-building"></i> Parul University</p>
            <p class="cert-description">Participation certificate for AWS cloud computing value-added course</p>
            <div class="cert-meta">
              <span class="cert-date"><i class="far fa-calendar"></i> 2025</span>
              <a href="#" class="cert-download">
                <i class="fas fa-eye"></i> View Certificate
              </a>
            </div>
          </div>
